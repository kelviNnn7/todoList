{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "BluNote 主窗口的最小必要权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "notification:default",
    "window-state:default",
    "autostart:default"
  ]
}
