{
  "name": "desktop-todo-widget",
  "private": true,
  "version": "0.3.2",
  "description": "跨平台桌面待办与会议挂件",
  "desktopName": "com.todo.desktop",
  "license": "MIT",
  "author": {
    "name": "Desktop Todo contributors",
    "email": "maintainers@todo.invalid"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run test && npm run build",
    "build:kylin-v10": "npm run check && electron-builder --linux deb --x64",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.todo.desktop",
    "productName": "BluNote",
    "artifactName": "BluNote-${version}-kylin-v10-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN"
    ],
    "protocols": [
      {
        "name": "Todo Widget Link",
        "schemes": [
          "todo-widget"
        ]
      }
    ],
    "directories": {
      "output": "release/kylin-v10-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src-tauri/icons/icon.png",
      "src-tauri/icons/32x32.png",
      "!node_modules{,/**/*}"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "src-tauri/icons/icon.png",
      "executableName": "desktop-todo",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
